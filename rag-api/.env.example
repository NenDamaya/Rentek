# NestJS API (proyecto independiente)
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de datos compartida con el servicio RAG
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rentek
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT (debe coincidir con el usado por el frontend/servicio RAG)
JWT_SECRET=change-me-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Servicio rag-agent (interno, solo accesible desde la API)
RAG_AGENT_URL=http://localhost:8000
RAG_AGENT_TIMEOUT=60000

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
